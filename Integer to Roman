#include <stdlib.h>
#include <string.h>

char* intToRoman(int num) {
    // Values and corresponding Roman numeral symbols sorted from largest to smallest
    int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    char* symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    // Allocate enough memory for the largest possible Roman numeral string up to 3999
    // "MMMCMXCIX" is 9 characters + 1 for null terminator
    char* result = (char*)malloc(sizeof(char) * 20);
    result[0] = '\0'; // Initialize as empty string
    
    for (int i = 0; i < 13; i++) {
        // While the current value can fit into num, append its symbol
        while (num >= values[i]) {
            strcat(result, symbols[i]);
            num -= values[i];
        }
    }
    
    return result;
}
