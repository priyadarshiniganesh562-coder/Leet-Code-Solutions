    void reverce(char *s){
    printf("%d\n",strlen(s));
    for(int i=0;i<strlen(s)/2;i++){
        char temp = s[i];
        s[i] = s[strlen(s)-i-1];
        s[strlen(s)-i-1] = temp;
    }
}
    
char* reverseWords(char* s) {
    char* res = (char*)malloc(sizeof(char)*(strlen(s)+4));
    res[0] = '\0';
    char* token = strtok(s," ");
    while(token!=NULL){
        reverce(token);
        strcat(res,token);
        strcat(res," ");
        token = strtok(NULL," ");
    }
    res[strlen(res)-1] = '\0';
    return res;
}
    
